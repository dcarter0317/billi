{
  "expo": {
    "name": "billi",
    "slug": "billi",
    "scheme": "billi",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.billi.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "14"
    },
    "android": {
      "package": "com.dcartdevelopment.billi",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Billi accesses your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Billi uses Face ID to unlock the app and protect your financial data."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ae5cfbc-1280-405a-a7a3-651d9b5f8e6b"
      }
    },
    "owner": "dcarter0317"
  }
}
